# Copy this file to .env and fill in both keys.

# Required. The agent cannot answer without it.
GEMINI_API_KEY=

# Needed for web re-checks. Without it, questions about your records still work.
TAVILY_API_KEY=

# Optional. Port for the single dev server (default 3000).
# PORT=3000

# Optional. Models to answer with, best first, comma-separated. When one hits
# its free-tier limit the answer moves to the next. Default:
# gemini-4-hydrogen,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MODELS=
